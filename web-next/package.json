{
  "name": "doabno-web-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-v2.mjs",
    "predev": "node scripts/sync-v2.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/sync-v2.mjs --fresh-data",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "cf:build": "node scripts/sync-v2.mjs --fresh-data && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
