# Leave both empty to run on the built-in demo catalogue (web-v2/assets/data.js).
# The Supabase project URL and its publishable (anon) key. Both are public by design. Never put a service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The site's public address, used for canonical links, hreflang and the sitemap.
SITE_URL=http://localhost:3100
# Optional: address of the "go" click function, for Visit store buttons.
NEXT_PUBLIC_CLICK_OUT_URL=
