{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doabno-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference, required for ISR revalidation by the memory queue. Must equal "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "doabno-web" }
  ],
  "r2_buckets": [
    // Create the bucket first: npx wrangler r2 bucket create doabno-next-cache
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "doabno-next-cache" }
  ],
  "vars": {
    // Placeholder. Set the real public address in the Cloudflare dashboard (Settings > Variables and secrets).
    "SITE_URL": "https://example.com"
    // SUPABASE_URL, SUPABASE_ANON_KEY and NEXT_PUBLIC_CLICK_OUT_URL are public values; set them in the dashboard
    // (and as build variables for NEXT_PUBLIC_*), not here. Never put a service_role key anywhere.
  }
}
